{
  "name": "dev-backup",
  "version": "1.0.2",
  "description": "Cold backup for a dev workspace: git bundles, directory snapshots and config whitelists into any folder your cloud client already syncs. Zero dependencies, bash 3.2+, macOS and Linux (工作区冷备 CLI)",
  "bin": {
    "dev-backup": "bin/dev-backup"
  },
  "files": [
    "bin/dev-backup",
    "install.sh",
    "docs/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bash test/lint.sh && bash test/selftest.sh",
    "test:frozen": "bash test/frozen-clock.sh"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "backup",
    "cold-backup",
    "git-bundle",
    "workspace",
    "snapshot",
    "onedrive",
    "icloud",
    "dropbox",
    "launchd",
    "cron",
    "bash",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haotian-lu-prog/dev-backup.git"
  },
  "homepage": "https://github.com/haotian-lu-prog/dev-backup#readme",
  "bugs": {
    "url": "https://github.com/haotian-lu-prog/dev-backup/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT"
}
